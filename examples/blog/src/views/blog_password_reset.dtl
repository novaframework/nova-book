{% extends "blog_layout.dtl" %}
{% block title %}Choose a new password{% endblock %}
{% block content %}
<h1>Choose a new password</h1>
<form method="post" action="/password/reset">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
  <input type="hidden" name="token" value="{{ token }}">
  <div class="field">
    <label for="password">New password (at least 12 characters)</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>
    {% include "partials/errors.dtl" with messages=errors.password %}
  </div>
  <div class="field">
    <label for="password_confirmation">Repeat password</label>
    <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required>
    {% include "partials/errors.dtl" with messages=errors.password_confirmation %}
  </div>
  <button type="submit">Change password</button>
</form>
{% endblock %}
