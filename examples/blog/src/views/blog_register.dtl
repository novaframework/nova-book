{% extends "blog_layout.dtl" %}
{% block title %}Register{% endblock %}
{% block content %}
<h1>Register</h1>
<form method="post" action="/register">
  <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="{{ form.email }}" autocomplete="email" required>
    {% include "partials/errors.dtl" with messages=errors.email %}
  </div>
  <div class="field">
    <label for="username">Username</label>
    <input id="username" name="username" value="{{ form.username }}" autocomplete="username" required>
    {% include "partials/errors.dtl" with messages=errors.username %}
  </div>
  <div class="field">
    <label for="full_name">Full name (optional)</label>
    <input id="full_name" name="full_name" value="{{ form.full_name }}" autocomplete="name">
  </div>
  <div class="field">
    <label for="password">Password (at least 12 characters)</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>
    {% include "partials/errors.dtl" with messages=errors.password %}
  </div>
  <div class="field">
    <label for="password_confirmation">Repeat password</label>
    <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required>
    {% include "partials/errors.dtl" with messages=errors.password_confirmation %}
  </div>
  <button type="submit">Create account</button>
</form>
{% endblock %}
