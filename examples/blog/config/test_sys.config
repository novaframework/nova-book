%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-
[
 {kernel, [{logger_level, warning}]},
 {blog, [{json_lib, blog_json}, {ops_token, ~"test-ops-token"}]},
 {nova, [
     {environment, test},
     {cowboy_configuration, #{
         port => 8081,
         stream_handlers => [nova_stream_h, blog_session_h, cowboy_compress_h, cowboy_stream_h]
     }},
     {dev_mode, false},
     {bootstrap_application, blog},
     {plugins, [
         {pre_request, nova_request_plugin, #{decode_json_body => true,
                                              read_urlencoded_body => true}}
     ]}
 ]},
 {kura, [
     {repos, #{
         blog_repo => #{
             backend => kura_backend_postgres,
             host => "localhost",
             port => 5432,
             database => "blog_test",
             user => "postgres",
             password => "postgres",
             pool_size => 5
         }
     }},
     {encryption, #{
         active => 1,
         keys => [{1, <<"NjHOkZjxdIwZEU7rV+svAvcAta1SReTrD/vMnPF/9hQ=">>}]
     }}
 ]}
].
